{
  "name": "kreatya-labs",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "e2e": "playwright test",
    "db:generate": "pnpm --filter @kreatya/db generate",
    "preview:static": "node scripts/build-preview.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.2.4",
    "@playwright/test": "1.56.1",
    "turbo": "2.5.8",
    "typescript": "5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd",
      "@biomejs/biome"
    ]
  }
}
