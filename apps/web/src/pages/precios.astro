---
import { Icon } from '@kreatya/ui';
import { formatEuros } from '@kreatya/shared';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import InvestmentCalculator from '../islands/InvestmentCalculator';
import Base from '../layouts/Base.astro';
import { faqPage, offers } from '../lib/jsonld';
import { getSnapshot } from '../lib/snapshot';

const s = await getSnapshot();
const faqs = s.faqs.filter((f) => f.scope === 'pricing' || f.question.startsWith('¿Cuánto'));
---
<Base title="Precios: ¿cuánto cuesta un software a medida?" description="Rangos de precio publicados: MVP desde 12.000 €, sistema completo de 25.000 a 80.000 € y evolución mensual. Calcula tu inversión orientativa." jsonld={[offers(s.pricingTiers), faqPage(faqs)]} breadcrumbs={[{ name: 'Inicio', href: '/' }, { name: 'Precios', href: '/precios' }]}>
  <section class="wrap pb-12 pt-8">
    <h1 class="text-title max-w-[22ch]">Sabrás cuánto cuesta antes de empezar</h1>
    <p class="mt-6 max-w-[60ch] text-lead text-muted">¿Cuánto cuesta un software a medida? Un MVP útil cuesta entre 12.000 y 25.000 €, y un sistema completo entre 25.000 y 80.000 €, según módulos e integraciones. Cerramos el presupuesto por fase y no cobramos por usuario.</p>
  </section>
  <section class="wrap pb-16" aria-label="Formatos">
    <ul class="grid gap-6 lg:grid-cols-3">
      {s.pricingTiers.map((t, i) => (
        <li class:list={['grid content-start gap-4 rounded-xl border bg-raised p-6', i === 1 ? 'border-fg ring-1 ring-fg' : 'border-line']}>
          <div class="flex items-center justify-between"><h2 class="text-heading">{t.name}</h2>{i === 1 && <span class="rounded-sm bg-signal px-2 py-0.5 text-xs font-semibold text-ink">El más habitual</span>}</div>
          <p class="font-display text-3xl font-semibold tabular-nums">{t.priceTo ? `${formatEuros(t.priceFrom)} – ${formatEuros(t.priceTo)}` : `desde ${formatEuros(t.priceFrom)}`}<span class="text-base font-normal text-muted">{t.unit === 'EUR/mes' ? ' /mes' : ''}</span></p>
          <p class="text-muted">{t.description}</p>
          <ul class="grid gap-2 border-t border-line pt-4 text-sm">{t.includes.map((x) => <li class="flex gap-2"><span class="mt-0.5 text-positive"><Icon name="check" size={16} /></span>{x}</li>)}</ul>
        </li>
      ))}
    </ul>
    <p class="mt-4 text-sm text-muted">Precios orientativos sin IVA. Sin coste por usuario: el software, el código y los datos son tuyos.</p>
  </section>
  <section class="border-y border-line" aria-labelledby="calc">
    <div class="wrap py-16">
      <h2 id="calc" class="text-title">Calcula tu inversión orientativa</h2>
      <div class="mt-8"><InvestmentCalculator client:visible /></div>
    </div>
  </section>
  <Faq faqs={faqs} title="Dudas sobre precios" />
  <CtaBand />
</Base>
