---
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import AiDocDemo from '../islands/AiDocDemo';
import Base from '../layouts/Base.astro';
import { faqPage, service } from '../lib/jsonld';
import { getSnapshot } from '../lib/snapshot';

const s = await getSnapshot();
const departments = [...new Set(s.aiUseCases.map((u) => u.department))];
const faqs = s.faqs.filter((f) => f.scope === 'ai');
const total = s.aiUseCases.reduce((n, u) => n + u.hoursSaved, 0);
const desc = 'Inteligencia artificial aplicada para pymes: lectura de facturas, resúmenes de llamadas, asistentes y propuestas. Casos de uso por departamento con horas ahorradas.';
---
<Base title="Inteligencia artificial para empresas" description={desc} jsonld={[service('Inteligencia artificial para empresas', desc, '/ia-para-empresas'), faqPage(faqs)]} breadcrumbs={[{ name: 'Inicio', href: '/' }, { name: 'IA para empresas', href: '/ia-para-empresas' }]}>
  <section class="reticula border-b border-line">
    <div class="wrap grid gap-6 pb-14 pt-8">
      <p class="eyebrow">IA aplicada</p>
      <h1 class="h-display max-w-[18ch] text-4xl sm:text-6xl">IA que trabaja con tu equipo, no en su lugar</h1>
      <p class="max-w-[62ch] border-l-2 border-signal bg-bg/80 py-3 pl-4 text-lg">La IA en una pyme funciona cuando se aplica a tareas repetitivas y medibles: leer facturas, resumir llamadas, clasificar correos o responder preguntas frecuentes. La IA propone y tu equipo revisa y decide. Con los {s.aiUseCases.length} casos de esta página, un equipo tipo ahorra unas {total} horas a la semana.</p>
    </div>
  </section>

  <section class="wrap py-16" aria-labelledby="casos-uso">
    <h2 id="casos-uso" class="text-3xl font-semibold">Casos de uso por departamento</h2>
    <div class="mt-8 grid gap-10">
      {departments.map((d) => (
        <div class="grid gap-4 lg:grid-cols-[1fr_3fr]">
          <h3 class="cota pt-2 text-sm">{d}</h3>
          <ul class="grid gap-4 md:grid-cols-2">
            {s.aiUseCases.filter((u) => u.department === d).map((u) => (
              <li class="grid content-start gap-2 border border-line bg-raised p-5">
                <div class="flex items-start justify-between gap-4">
                  <h4 class="font-display text-lg font-semibold">{u.title}</h4>
                  <p class="shrink-0 font-display text-xl font-semibold text-positive-strong tabular-nums">{u.hoursSaved} h<span class="text-sm font-normal text-muted">/sem</span></p>
                </div>
                <p class="text-muted">{u.description}</p>
                {u.demoKey && <a href="#demo" class="text-sm text-diagram underline underline-offset-4">Probar mini demo</a>}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <section id="demo" class="border-y border-line bg-raised" aria-labelledby="demo-title">
    <div class="wrap grid gap-6 py-16">
      <h2 id="demo-title" class="text-3xl font-semibold">Mini demo: lectura de documentos</h2>
      <AiDocDemo client:visible />
    </div>
  </section>

  <section class="wrap grid gap-8 py-16 lg:grid-cols-[1fr_2fr]" aria-labelledby="privacidad">
    <h2 id="privacidad" class="text-3xl font-semibold">Privacidad y cumplimiento</h2>
    <div class="prose-k">
      <p class="border-l-2 border-signal bg-raised py-4 pl-5 pr-4 text-lg">Tus datos se procesan en infraestructura europea siempre que es posible, nunca se usan para entrenar modelos y cada proveedor queda documentado en un acuerdo de encargo de tratamiento.</p>
      <ul>
        <li><strong>RGPD:</strong> evaluación de impacto cuando procede, minimización de datos y registro de actividades de tratamiento.</li>
        <li><strong>Reglamento europeo de IA:</strong> clasificamos cada caso de uso por nivel de riesgo e informamos a los usuarios cuando interactúan con un sistema de IA.</li>
        <li><strong>Supervisión humana:</strong> la IA propone; las decisiones con impacto las toma siempre una persona.</li>
        <li><strong>Trazabilidad:</strong> cada respuesta queda registrada para auditoría, con datos personales anonimizados.</li>
      </ul>
    </div>
  </section>
  <Faq faqs={faqs} title="Dudas sobre IA" />
  <CtaBand title="¿Dónde ahorraría horas la IA en tu empresa?" href="/diagnostico?tipo=ia" />
</Base>
