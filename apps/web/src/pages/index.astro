---
import { siteConfig } from '@kreatya/shared/site.config';
import { Icon } from '@kreatya/ui';
import Hero from '../components/Hero.astro';
import MetodoCinta from '../components/MetodoCinta.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Testimonial from '../components/Testimonial.astro';
import AiDocDemo from '../islands/AiDocDemo';
import PainSelector, { type PainOption } from '../islands/PainSelector';
import SavingsCalculator from '../islands/SavingsCalculator';
import Base from '../layouts/Base.astro';
import { faqPage } from '../lib/jsonld';
import { sectorName } from '../lib/projects';
import { clientLabel, formatMetric, getSnapshot } from '../lib/snapshot';

const s = await getSnapshot();
const featured = s.projects.filter((p) => p.featured).slice(0, 5);
const [leadProject, ...restFeatured] = featured;
const homeFaqs = s.faqs.filter((f) => f.scope === 'home');
const [mainQuote, ...otherQuotes] = s.testimonials;

const painDefs = [
  { label: 'Excel por todas partes', detail: 'Órdenes, partes y costes viven en hojas que nadie actualiza a la vez. El sistema y la planta cuentan historias distintas.', solution: 'erp-a-medida', project: 'erp-fabricacion-metal' },
  { label: 'Programas que no se hablan', detail: 'La tienda online, el TPV y el ERP llevan cada uno su stock. Alguien pasa dos días por semana cuadrándolos.', solution: 'integraciones', project: 'stock-omnicanal-moda' },
  { label: 'Tareas repetitivas', detail: 'Facturas que llegan por correo, WhatsApp y en mano, y alguien las teclea una a una al cierre del trimestre.', solution: 'portales-clientes', project: 'portal-clientes-asesoria' },
  { label: 'Papel en la calle', detail: 'Los albaranes firmados vuelven días después en la cabina del camión y la factura sale a final de mes.', solution: 'apps-moviles', project: 'albaran-digital-transportes-levante' },
  { label: 'Clientes que llaman para todo', detail: 'Cuatro de cada diez llamadas son para preguntar dónde está un envío.', solution: 'portales-clientes', project: 'portal-seguimiento-envios' },
  { label: 'Auditorías que paralizan', detail: 'Reconstruir el origen de cada partida a partir de cuadernos en papel ocupa una semana entera.', solution: 'software-a-medida', project: 'trazabilidad-cooperativa' },
];
const pains: PainOption[] = painDefs.flatMap((d) => {
  const p = s.projects.find((x) => x.slug === d.project);
  const sol = s.solutions.find((x) => x.slug === d.solution);
  if (!p || !sol || !p.metrics[0]) return [];
  return [{
    label: d.label,
    detail: d.detail,
    project: { href: `/proyectos/${p.slug}`, title: p.title, client: clientLabel(p, sectorName(s, p.sectors[0])), metric: formatMetric(p.metrics[0]), metricLabel: p.metrics[0].description, cover: p.cover },
    solution: { href: `/soluciones/${sol.slug}`, name: sol.name },
  }];
});

const pillars = [
  { title: 'Hecho para tu negocio, no al revés.', text: 'Primero recorremos tu operativa y dibujamos el plano del proceso real. Después escribimos la primera línea. Si ya tienes un ERP para la contabilidad, lo integramos en lugar de sustituirlo.' },
  { title: 'Lo usarás en semanas, no en años.', text: 'Construimos primero el módulo que más duele. Está en uso en 4–6 semanas y cada dos semanas entregamos algo que tu equipo ya puede usar.' },
  { title: 'La IA hará el trabajo pesado de tu equipo.', text: 'Leer facturas, resumir llamadas, clasificar correos. La aplicamos donde ahorra horas medibles; tu equipo revisa y decide.' },
  { title: 'Sabrás cuánto cuesta antes de empezar.', text: 'Publicamos rangos y cerramos presupuesto por fase. Sin coste por usuario. El código y los datos son tuyos desde el primer día.' },
];
---
<Base title={`Software a medida que entiende tu negocio | ${siteConfig.name}`} description={siteConfig.description} jsonld={[faqPage(homeFaqs)]}>
  <Hero projects={s.stats.projectsDelivered} rating={s.stats.averageRating} reviews={s.stats.reviews} />

  <section class="wrap seccion" aria-labelledby="frena">
    <div class="seccion-titulo grid gap-4 lg:grid-cols-[0.9fr_1.1fr] lg:items-end lg:gap-14">
      <h2 id="frena" class="text-title">¿Qué te frena hoy?</h2>
      <p class="max-w-[48ch] text-lead text-muted">Elige lo que más se parece a tu día a día y te enseñamos cómo lo resolvimos para otra empresa.</p>
    </div>
    <PainSelector client:visible options={pains} />
  </section>

  <section class="border-y border-line bg-raised" aria-labelledby="pilares">
    <div class="wrap seccion grid gap-12 lg:grid-cols-[0.8fr_1.2fr] lg:gap-16">
      <h2 id="pilares" class="text-title max-w-[13ch] lg:sticky lg:top-28 lg:self-start">Personalización alta, precio medio, IA incluida</h2>
      <ul class="grid">
        {pillars.map((p) => (
          <li class="grid gap-3 border-b border-line py-8 first:pt-0 last:border-0 last:pb-0 sm:grid-cols-[1fr_1.15fr] sm:gap-10">
            <h3 class="text-heading">{p.title}</h3>
            <p class="text-muted">{p.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="wrap seccion" aria-labelledby="destacados">
    <div class="seccion-titulo flex flex-wrap items-end justify-between gap-4">
      <h2 id="destacados" class="text-title max-w-[16ch]">Proyectos que ya están funcionando</h2>
      <a href="/proyectos" class="enlace inline-flex items-center gap-1.5">Ver los {s.projects.length} proyectos<Icon name="arrow-right" size={16} /></a>
    </div>
    {leadProject && <ProjectCard project={leadProject} snapshot={s} index={0} lead eager />}
    <div class="mt-6 grid gap-6 md:grid-cols-2">
      {restFeatured.map((p, i) => <ProjectCard project={p} snapshot={s} index={i + 1} />)}
    </div>
  </section>

  <section class="border-y border-line bg-raised" aria-labelledby="demo-ia">
    <div class="wrap seccion grid gap-12 lg:grid-cols-[0.75fr_1.25fr] lg:gap-16">
      <div>
        <h2 id="demo-ia" class="text-title">La IA hace el trabajo pesado de tu equipo</h2>
        <p class="mt-5 max-w-[42ch] text-muted">Elige un documento de ejemplo y mira cómo el copiloto extrae lo que hoy alguien teclea a mano. Es lo que usan nuestros clientes en administración, logística y atención al cliente.</p>
        <a href="/ia-para-empresas" class="enlace mt-6 inline-flex items-center gap-1.5">Casos de uso por departamento<Icon name="arrow-right" size={16} /></a>
      </div>
      <AiDocDemo client:visible />
    </div>
  </section>

  <section class="wrap seccion" aria-labelledby="metodo">
    <h2 id="metodo" class="seccion-titulo text-title max-w-[14ch]">Lo usarás en semanas, no en años</h2>
    <MetodoCinta />
  </section>

  <section class="border-y border-line bg-raised" aria-labelledby="calc">
    <div class="wrap seccion">
      <div class="seccion-titulo grid gap-4 lg:grid-cols-[0.9fr_1.1fr] lg:items-end lg:gap-14">
        <h2 id="calc" class="text-title">¿Cuánto te cuesta hoy el trabajo manual?</h2>
        <p class="max-w-[48ch] text-lead text-muted">Mueve los valores y mira el ahorro anual de automatizar esas tareas. La fórmula está a la vista.</p>
      </div>
      <SavingsCalculator client:visible />
    </div>
  </section>

  {mainQuote && (
    <section class="wrap seccion" aria-labelledby="testimonios">
      <h2 id="testimonios" class="sr-only">Lo que dicen nuestros clientes</h2>
      <div class="max-w-5xl"><Testimonial t={mainQuote} large /></div>
      <div class="mt-16 grid gap-10 border-t border-line pt-10 md:grid-cols-3">
        {otherQuotes.map((t) => <Testimonial t={t} />)}
      </div>
    </section>
  )}

  <div class="border-t border-line"><Faq faqs={homeFaqs} /></div>
  <CtaBand />
</Base>
