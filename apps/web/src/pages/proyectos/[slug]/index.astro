---
import type { GetStaticPaths } from 'astro';
import { COMPANY_SIZE_LABELS } from '@kreatya/shared';
import CtaBand from '../../../components/CtaBand.astro';
import Metrics from '../../../components/Metrics.astro';
import ProcessDiagram from '../../../components/ProcessDiagram.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import Testimonial from '../../../components/Testimonial.astro';
import VideoFacade from '../../../components/VideoFacade.astro';
import DemoRequestForm from '../../../islands/DemoRequestForm';
import Gallery from '../../../islands/Gallery';
import Base from '../../../layouts/Base.astro';
import { projectSchema } from '../../../lib/jsonld';
import { projectKinds, KIND_LABELS, sectorName } from '../../../lib/projects';
import { clientLabel, getSnapshot } from '../../../lib/snapshot';

export const getStaticPaths = (async () => {
  const s = await getSnapshot();
  return s.projects.map((p) => ({ params: { slug: p.slug } }));
}) satisfies GetStaticPaths;

const s = await getSnapshot();
const p = s.projects.find((x) => x.slug === Astro.params.slug)!;
const sector = sectorName(s, p.sectors[0]);
const client = clientLabel(p, sector);
const testimonial = s.testimonials.find((t) => t.id === p.testimonialId);
const related = p.related.map((slug) => s.projects.find((x) => x.slug === slug)).filter((x) => x !== undefined);
const services = p.solutions.map((slug) => s.solutions.find((x) => x.slug === slug)).filter((x) => x !== undefined);
const tech = p.technologies.map((slug) => s.technologies.find((x) => x.slug === slug)?.name).filter(Boolean);
const kinds = projectKinds(p, s);
const hasDemo = p.demoType !== 'none';
const similarHref = `/diagnostico?sector=${p.sectors[0] ?? ''}&tipo=${kinds[0] ?? ''}&desde=${p.slug}`;
---
<Base
  title={p.seo.title ?? p.title}
  description={p.seo.description ?? p.summary}
  jsonld={projectSchema(p, client, testimonial)}
  breadcrumbs={[{ name: 'Inicio', href: '/' }, { name: 'Proyectos', href: '/proyectos' }, { name: p.title, href: `/proyectos/${p.slug}` }]}
>
  <article>
    <!-- 1. Cabecera -->
    <header class="wrap grid gap-8 pb-12 pt-8 lg:grid-cols-[1.4fr_1fr]" style={`view-transition-name: ficha-${p.slug}`}>
      <div class="grid content-start gap-5">
        <h1 class="text-title max-w-[20ch]">{p.title}</h1>
        <p class="max-w-[60ch] text-lg text-muted">{p.summary}</p>
        <div class="flex flex-wrap gap-3">
          {hasDemo && <a href={p.demoType === 'on_request' ? '#demo' : `/proyectos/${p.slug}/demo`} class="btn btn-primary btn-draw" data-cta="probar-demo">Probar la demo</a>}
          <a href={similarHref} class="btn btn-secondary" data-cta="similar-header">Quiero algo parecido</a>
        </div>
      </div>
      <dl class="grid grid-cols-2 self-start rounded-3xl border border-line bg-raised text-sm">
        <div class="border-b border-r border-line p-4"><dt class="etiqueta">Sector</dt><dd class="mt-1 font-medium">{p.sectors.map((sl) => <a class="hover:text-diagram" href={`/sectores/${sl}`}>{sectorName(s, sl)}</a>)}</dd></div>
        <div class="border-b border-line p-4"><dt class="etiqueta">Plazo</dt><dd class="mt-1 font-medium tabular-nums">{p.durationWeeks} semanas</dd></div>
        <div class="border-b border-r border-line p-4"><dt class="etiqueta">Servicios</dt><dd class="mt-1 grid gap-1 font-medium">{services.map((x) => <a class="inline-block py-1 hover:text-diagram" href={`/soluciones/${x.slug}`}>{x.name}</a>)}</dd></div>
        <div class="border-b border-line p-4"><dt class="etiqueta">Empresa</dt><dd class="mt-1 font-medium">{COMPANY_SIZE_LABELS[p.companySize]}</dd></div>
        <div class="col-span-2 p-4"><dt class="etiqueta">Stack</dt><dd class="mt-1 font-medium">{tech.join(' · ')}</dd></div>
      </dl>
    </header>

    <!-- 2. Vídeo principal -->
    <section class="wrap pb-16" aria-label="Vídeo del proyecto">
      {p.mainVideo ? <VideoFacade video={p.mainVideo} title={p.title} /> : (
        <img src={p.cover} alt={`Vista general de la solución: ${p.title}`} width="1280" height="720" fetchpriority="high" class="aspect-video w-full rounded-3xl border border-line object-cover" />
      )}
    </section>

    <div class="wrap grid gap-20 pb-24 sm:gap-28">
      <!-- 3. El reto -->
      <section class="grid max-w-4xl gap-5" aria-labelledby="reto">
        <h2 id="reto" class="text-heading">El reto</h2>
        <p class="max-w-[65ch] text-lg">{p.challenge}</p>
      </section>

      <!-- 4. Antes / después -->
      <section class="grid max-w-4xl gap-5" aria-labelledby="proceso">
        <h2 id="proceso" class="text-heading">Antes y después del proceso</h2>
        <ProcessDiagram before={p.processBefore} after={p.processAfter} />
      </section>

      <!-- 5. La solución -->
      <section class="grid max-w-4xl gap-5" aria-labelledby="solucion">
        <h2 id="solucion" class="text-heading">La solución</h2>
        <div class="grid max-w-[65ch] gap-4 text-lg">
          <p>{p.solution}</p>
          {p.aiRole && (
            <div class="rounded-xl bg-raised p-5 text-base ring-1 ring-line"><h3 class="flex items-center gap-2 font-sans text-sm font-semibold tracking-normal"><span class="inline-block h-2.5 w-2.5 rounded-full bg-signal" aria-hidden="true"></span>Papel de la IA</h3><p class="mt-2">{p.aiRole}</p></div>
          )}
          <p class="text-base text-muted">Tipo de solución: {kinds.map((k) => KIND_LABELS[k]).join(', ')}.</p>
        </div>
      </section>

      <!-- 6. Galería -->
      {p.gallery.length > 0 && (
        <section aria-labelledby="galeria">
          <h2 id="galeria" class="mb-6 text-heading">Capturas</h2>
          <Gallery client:visible items={p.gallery} />
        </section>
      )}

      <!-- 7. Resultados -->
      <section aria-labelledby="resultados">
        <h2 id="resultados" class="mb-6 text-heading">Resultados</h2>
        <Metrics metrics={p.metrics} />
      </section>

      <!-- 8. Testimonio -->
      {testimonial && <section aria-label="Testimonio del cliente"><Testimonial t={testimonial} large /></section>}

      <!-- 9. Vista previa -->
      {hasDemo && (
        <section id="demo" aria-labelledby="demo-title" class="grid gap-4 rounded-3xl border border-line p-5 sm:p-8">
          <h2 id="demo-title" class="text-heading">Prueba la solución</h2>
          {p.demoType === 'on_request' ? (
            <>
              <p class="max-w-[60ch] text-muted">Esta demo contiene datos de un entorno real anonimizado. Déjanos tus datos y te enviamos un acceso temporal.</p>
              <DemoRequestForm client:visible projectSlug={p.slug} projectTitle={p.title} />
            </>
          ) : (
            <>
              <p class="max-w-[60ch] text-muted">Recorrido guiado de {p.demoTour.length} pasos por las pantallas principales, en escritorio, tablet y móvil.</p>
              <a href={`/proyectos/${p.slug}/demo`} class="btn btn-primary justify-self-start" data-cta="abrir-demo">Abrir la demo</a>
            </>
          )}
        </section>
      )}
    </div>

    <!-- 10. Relacionados + CTA -->
    {related.length > 0 && (
      <section class="border-t border-line bg-raised" aria-labelledby="relacionados">
        <div class="wrap py-16">
          <h2 id="relacionados" class="text-heading">Proyectos relacionados</h2>
          <div class="mt-8 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {related.map((r) => <ProjectCard project={r} snapshot={s} index={s.projects.indexOf(r)} />)}
          </div>
        </div>
      </section>
    )}
    <CtaBand title="¿Quieres algo parecido?" text={`Te contamos en 45 minutos cómo adaptaríamos esta solución a tu empresa${sector ? ` del sector ${sector.toLowerCase()}` : ''}.`} href={similarHref} label="Quiero algo parecido" />
  </article>
  <script define:vars={{ slug: p.slug }}>
    window.__projectSlug = slug;
  </script>
  <script>
    import { track } from '../../../lib/track';
    track('project_view', undefined, (window as unknown as { __projectSlug: string }).__projectSlug);
  </script>
</Base>
