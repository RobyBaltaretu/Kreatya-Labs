---
import { Icon } from '@kreatya/ui';
import DiagnosticForm from '../islands/DiagnosticForm';
import Base from '../layouts/Base.astro';
import { KIND_LABELS } from '../lib/projects';
import { getSnapshot } from '../lib/snapshot';
const s = await getSnapshot();
---
<Base title="Diagnóstico gratuito" description="Cuéntanos tu proceso en 2 minutos y reserva 45 minutos con un arquitecto de software. Estimación orientativa de plazo y precio, sin compromiso." breadcrumbs={[{ name: 'Inicio', href: '/' }, { name: 'Diagnóstico gratuito', href: '/diagnostico' }]}>
  <section class="">
    <div class="wrap grid gap-10 pb-20 pt-8 lg:grid-cols-[1fr_1.6fr]">
      <div class="grid content-start gap-5">
        <h1 class="text-title">Dibujemos el plano de tu negocio</h1>
        <p class="text-lg text-muted">Cinco preguntas, menos de dos minutos. Al final eliges día y hora para hablar 45 minutos con un arquitecto.</p>
        <ul class="grid gap-3 border-t border-line pt-5 text-sm">
          <li class="flex gap-3"><span class="mt-0.5 text-positive"><Icon name="check" size={18} /></span>Estimación orientativa de plazo y precio en 48 h</li>
          <li class="flex gap-3"><span class="mt-0.5 text-positive"><Icon name="check" size={18} /></span>Casos parecidos al tuyo, incluidos los que están bajo NDA</li>
          <li class="flex gap-3"><span class="mt-0.5 text-positive"><Icon name="check" size={18} /></span>Sin compromiso y sin llamadas comerciales insistentes</li>
        </ul>
      </div>
      <DiagnosticForm client:load sectors={s.sectors.map((x) => ({ slug: x.slug, name: x.name }))} kindLabels={KIND_LABELS} />
    </div>
  </section>
</Base>
