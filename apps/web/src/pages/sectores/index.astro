---
import { Icon } from '@kreatya/ui';
import CtaBand from '../../components/CtaBand.astro';
import Base from '../../layouts/Base.astro';
import { getSnapshot } from '../../lib/snapshot';
const s = await getSnapshot();
---
<Base title="Software a medida por sector" description="Software a medida para industria, logística, retail, salud, agroalimentario y servicios profesionales. Casos reales y módulos típicos por sector." breadcrumbs={[{ name: 'Inicio', href: '/' }, { name: 'Sectores', href: '/sectores' }]}>
  <section class="wrap pb-20 pt-10">
    <h1 class="text-title max-w-[22ch]">Conocemos cómo trabaja tu sector</h1>
    <ul class="mt-14 border-t border-line">
      {s.sectors.map((x) => {
        const n = s.projects.filter((p) => p.sectors.includes(x.slug)).length;
        return (
          <li>
            <a href={`/sectores/${x.slug}`} class="fila group grid gap-2 border-b border-line py-7 sm:grid-cols-[1fr_1.2fr_auto] sm:items-center sm:gap-10">
              <h2 class="text-heading">{x.name}</h2>
              <p class="text-muted">{x.pain}</p>
              <span class="flex items-center gap-3 text-sm text-muted">{n} {n === 1 ? 'caso' : 'casos'}<Icon name="arrow-right" /></span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
  <CtaBand />
</Base>
