---
import { siteConfig } from '@kreatya/shared/site.config';
import CtaBand from '../components/CtaBand.astro';
import Base from '../layouts/Base.astro';
import { getSnapshot } from '../lib/snapshot';
const s = await getSnapshot();
const values = [
  ['Negocio antes que código', 'Primero entendemos el proceso; después escribimos la primera línea.'],
  ['Valor temprano', 'Entregas útiles cada 2 semanas; usas algo real en el primer sprint.'],
  ['Transparencia de precio', 'Rangos publicados y presupuestos cerrados por fase.'],
  ['IA con criterio', 'La aplicamos donde ahorra tiempo medible, no como decoración.'],
  ['Propiedad del cliente', 'El código y los datos son tuyos desde el primer día.'],
];
---
<Base title="Empresa: quiénes somos" description={`${siteConfig.name}: estudio de arquitectura de software a medida e IA aplicada para pymes. Misión, valores y equipo.`} breadcrumbs={[{ name: 'Inicio', href: '/' }, { name: 'Empresa', href: '/empresa' }]}>
  <section class="wrap grid gap-10 pb-16 pt-8 lg:grid-cols-2">
    <div>
      <p class="eyebrow">Empresa</p>
      <h1 class="h-display mt-3 text-4xl sm:text-6xl">Un estudio de arquitectura para tu software</h1>
    </div>
    <div class="grid content-end gap-4 text-lg">
      <p><strong>Visión.</strong> Que cualquier empresa, sea del tamaño o sector que sea, trabaje con un software pensado para su negocio y una IA que le quite horas de trabajo repetitivo a cada persona del equipo.</p>
      <p class="text-muted"><strong class="text-fg">Misión.</strong> Diseñamos y desarrollamos sistemas a medida que entienden cómo funciona tu negocio, aportan valor desde el primer día y cuestan lo que de verdad valen: ni plantillas genéricas ni proyectos interminables.</p>
    </div>
  </section>
  <section class="border-y border-line bg-raised" aria-labelledby="valores">
    <div class="wrap py-16">
      <h2 id="valores" class="text-3xl font-semibold">Valores</h2>
      <dl class="mt-8 grid gap-px border border-line bg-line md:grid-cols-2 lg:grid-cols-5">
        {values.map(([t, d]) => <div class="bg-bg p-5"><dt class="font-display text-lg font-semibold">{t}</dt><dd class="mt-2 text-sm text-muted">{d}</dd></div>)}
      </dl>
    </div>
  </section>
  <section class="wrap py-16" aria-labelledby="equipo">
    <h2 id="equipo" class="text-3xl font-semibold">Equipo</h2>
    <p class="mt-3 max-w-[60ch] text-muted">Ingenieros y consultores de procesos. Aquí irán las fotografías reales del equipo trabajando (sin stock genérico).</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {s.authors.map((a) => (
        <li class="border border-line bg-raised p-5"><p class="font-display text-lg font-semibold">{a.name}</p><p class="cota mt-1">{a.role}</p><p class="mt-3 text-sm text-muted">{a.bio}</p></li>
      ))}
    </ul>
    <dl class="mt-10 grid max-w-xl grid-cols-3 border-y border-line py-4">
      <div><dt class="cota">Proyectos</dt><dd class="font-display text-3xl font-semibold tabular-nums">{s.stats.projectsDelivered}</dd></div>
      <div class="border-x border-line px-4"><dt class="cota">Años</dt><dd class="font-display text-3xl font-semibold tabular-nums">{s.stats.yearsActive}</dd></div>
      <div class="pl-4"><dt class="cota">Reseñas</dt><dd class="font-display text-3xl font-semibold tabular-nums">{s.stats.reviews}</dd></div>
    </dl>
  </section>
  <CtaBand />
</Base>
