---
import Base from '../../layouts/Base.astro';
import { formatDate, getSnapshot } from '../../lib/snapshot';
const s = await getSnapshot();
const pillars = { 'software-a-medida': 'Software a medida', 'ia-para-empresas': 'IA para empresas', 'software-por-sector': 'Software por sector' } as const;
---
<Base title="Blog y guías sobre software a medida e IA" description="Guías prácticas sobre precios de software a medida, cómo implantar IA en una pyme y digitalización por sector." breadcrumbs={[{ name: 'Inicio', href: '/' }, { name: 'Blog', href: '/blog' }]}>
  <section class="wrap pb-20 pt-8">
    <h1 class="text-title max-w-[22ch]">Blog y guías</h1>
    <ul class="mt-10 grid gap-6 md:grid-cols-2">
      {s.posts.map((p) => (
        <li class="border border-line bg-raised">
          <a href={`/${p.kind === 'guia' ? 'guias' : 'blog'}/${p.slug}`} class="group grid h-full content-start gap-3 p-6">
            <p class="etiqueta">{p.kind === 'guia' ? 'Guía' : 'Blog'} · {pillars[p.pillar]}</p>
            <h2 class="text-heading">{p.title}</h2>
            <p class="text-muted">{p.excerpt}</p>
            <p class="text-sm text-muted"><time datetime={p.publishedAt}>{formatDate(p.publishedAt)}</time></p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
