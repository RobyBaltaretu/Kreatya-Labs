---
import Base from '../layouts/Base.astro';
---
<Base title="Página no encontrada" description="Esta página no existe o se ha movido." noindex ogImage="/og/home.png">
  <section class="wrap grid gap-6 py-24">
        <h1 class="text-title max-w-[22ch]">Esta página no está en el plano</h1>
    <p class="max-w-[50ch] text-lg text-muted">Puede que se haya movido o que el enlace tenga una errata. Estos caminos sí existen:</p>
    <ul class="flex flex-wrap gap-3">
      <li><a href="/" class="btn btn-secondary">Inicio</a></li>
      <li><a href="/proyectos" class="btn btn-secondary">Proyectos</a></li>
      <li><a href="/diagnostico" class="btn btn-primary">Diagnóstico gratuito</a></li>
    </ul>
  </section>
</Base>
