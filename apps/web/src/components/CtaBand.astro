---
import { siteConfig } from '@kreatya/shared/site.config';
import { Icon } from '@kreatya/ui';
interface Props { title?: string; text?: string; href?: string; label?: string; }
const {
  title = '¿Le damos forma a tu proceso?',
  text = 'En 45 minutos analizamos tu proceso y te damos una estimación orientativa de plazo y precio. Sin compromiso.',
  href = siteConfig.primaryCta.href,
  label = siteConfig.primaryCta.label,
} = Astro.props;
---
<section class="wrap py-16 sm:py-24">
  <div class="cta sobre-tinta relative overflow-hidden rounded-[2.25rem] bg-tinta">
    <div class="cta-respaldo absolute inset-0" aria-hidden="true"></div>
    <canvas class="cta-liquido absolute inset-0 h-full w-full" aria-hidden="true" data-liquido-cta></canvas>
    <div class="relative grid gap-10 px-6 py-14 sm:px-12 sm:py-20 md:grid-cols-[1.6fr_1fr] md:items-end">
      <div>
        <h2 class="text-title max-w-[18ch]">{title}</h2>
        <p class="mt-5 max-w-[52ch] text-lead text-muted">{text}</p>
      </div>
      <div class="flex md:justify-end">
        <a href={href} class="btn btn-primary text-lg" data-cta="band">{label}<Icon name="arrow-right" /></a>
      </div>
    </div>
  </div>
</section>
<style>
  .cta-respaldo {
    background: radial-gradient(38% 60% at 88% 78%, rgb(255 178 26 / 0.55), transparent 70%);
  }
  .cta-liquido {
    opacity: 0;
    transition: opacity 900ms ease;
  }
  .cta-liquido[data-listo] {
    opacity: 1;
  }
</style>
<script>
  import { initLiquidField } from '../lib/liquid-field';
  for (const c of document.querySelectorAll<HTMLCanvasElement>('[data-liquido-cta]')) {
    initLiquidField(c, innerWidth >= 768 ? { bias: [0.86, 0.4], mascara: 0.55, fondo: '#1d1d1f', tamano: 1.5 } : { bias: [0.78, 0.25], fondo: '#1d1d1f', tamano: 1.1 });
  }
</script>
