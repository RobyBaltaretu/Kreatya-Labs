---
/**
 * Hero «Líquido». El ámbar fluye (WebGL) y adopta formas; el titular aparece palabra a
 * palabra con desenfoque (Motion); la película vive en un dispositivo con marco de
 * vidrio líquido que refracta el ámbar de detrás. Todo legible sin JS; con reduced motion
 * no hay animación ni reproducción automática.
 */
import { siteConfig } from '@kreatya/shared/site.config';
import { Icon } from '@kreatya/ui';

interface Props { projects: number; rating: number; reviews: number }
const { projects, rating, reviews } = Astro.props;
const palabras = ['Software', 'que', 'toma', 'la', 'forma', 'de', 'tu', 'negocio.'];
---
<section class="hero relative isolate overflow-hidden" aria-labelledby="hero-title">
  <div class="liquido-respaldo absolute inset-0 -z-10" aria-hidden="true"></div>
  <canvas class="liquido absolute inset-0 -z-10 h-full w-full" aria-hidden="true" data-liquido></canvas>

  <div class="wrap grid items-center gap-x-12 gap-y-14 pb-24 pt-32 sm:pt-36 lg:min-h-[min(92svh,960px)] lg:grid-cols-[minmax(0,1.05fr)_minmax(0,1fr)] lg:pb-28">
    <div class="grid gap-8">
      <h1 id="hero-title" class="titular">
        {palabras.map((p, i) => <><span class="palabra" style={`--i:${i}`}>{p}</span>{i < palabras.length - 1 && ' '}</>)}
      </h1>
      <p class="aparece max-w-[42ch] text-lead text-muted" style="--i:8">Construimos el sistema que tu empresa necesita, con IA que le quita a tu equipo el trabajo repetitivo. En uso en semanas, con el precio claro desde el primer día.</p>
      <div class="aparece flex flex-wrap items-center gap-3" style="--i:9">
        <a href={siteConfig.primaryCta.href} class="btn btn-primary text-[1.0625rem]" data-cta="hero">Diagnóstico gratuito<Icon name="arrow-right" /></a>
        <a href="/proyectos" class="btn btn-glass glass-luz text-[1.0625rem]" data-cta="hero-proyectos">Ver proyectos en vivo</a>
      </div>
      <p class="aparece text-sm text-muted" style="--i:10">{projects} proyectos entregados · {rating.toLocaleString('es-ES')}/5 de media en {reviews} reseñas</p>
    </div>

    <figure class="dispositivo-wrap grid gap-4" data-dispositivo>
      <div class="dispositivo glass rounded-[2rem] p-2.5 sm:p-3" data-glass data-glass-grosor="80" data-glass-bisel="26">
        <div class="pantalla relative overflow-hidden rounded-[1.4rem] bg-[#0b0b0c]">
          <img src="/video/a-medida-poster.webp" alt="" width="1280" height="720" fetchpriority="high" decoding="async" class="block aspect-video w-full" />
          <video class="video-capa absolute inset-px block h-[calc(100%-2px)] w-[calc(100%-2px)]" autoplay muted loop playsinline preload="auto" width="1280" height="720" aria-describedby="pelicula-desc" data-pelicula>
            <source src="/video/a-medida.webm" type="video/webm" />
            <source src="/video/a-medida.mp4" type="video/mp4" />
          </video>
          <button type="button" class="pelicula-boton btn-glass absolute bottom-3 right-3 grid h-10 w-10 place-items-center rounded-full text-[#f5f5f7]" data-pelicula-toggle aria-label="Pausar la película">
            <span data-icono="pausa"><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M8 5v14M16 5v14" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"></path></svg></span>
            <span data-icono="play" hidden><svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M8 5.5v13l10.5-6.5Z" fill="currentColor"></path></svg></span>
          </button>
        </div>
      </div>
      <figcaption id="pelicula-desc" class="text-sm"><span class="pie glass inline-block rounded-2xl px-3.5 py-2">Del Excel y el WhatsApp a una aplicación a medida, en 12 segundos.</span></figcaption>
    </figure>
  </div>
</section>

<style>
  .liquido-respaldo {
    background:
      radial-gradient(40% 50% at 78% 42%, rgb(255 178 26 / 0.55), transparent 70%),
      radial-gradient(30% 40% at 62% 78%, rgb(255 120 20 / 0.35), transparent 70%),
      var(--bg);
  }
  .liquido {
    opacity: 0;
    transition: opacity 900ms ease;
  }
  .liquido[data-listo] {
    opacity: 1;
  }
  .titular {
    font-size: clamp(2.75rem, 1.1rem + 4.4vw, 4.75rem);
    font-weight: 600;
    line-height: 0.98;
    letter-spacing: -0.045em;
    max-width: 12ch;
  }
  .palabra {
    display: inline-block;
  }
  /* Con JS, las palabras parten desenfocadas; respaldo CSS a los 2,4 s si Motion no llega. */
  :global(html.js) .palabra,
  :global(html.js) .aparece {
    opacity: 0;
    filter: blur(10px);
    animation: aparece-respaldo 0.01s 2.4s forwards;
  }
  @keyframes aparece-respaldo {
    to { opacity: 1; filter: none; transform: none; }
  }
  .dispositivo {
    --glass-tint: rgb(255 255 255 / 0.22);
  }
  .pie {
    --glass-tint: var(--glass-tint-strong);
  }
  .video-capa {
    opacity: 0;
    transition: opacity 300ms ease;
  }
  .video-capa[data-listo] {
    opacity: 1;
  }
  .pelicula-boton {
    transition: transform var(--dur-press) var(--ease-out);
  }
  .pelicula-boton:active {
    transform: scale(0.94);
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .palabra,
    :global(html.js) .aparece { opacity: 1; filter: none; animation: none; }
    .liquido { transition: none; }
  }
</style>

<script>
  import { initLiquidGlass, initLuzGlass } from '@kreatya/ui/liquid-glass';
  import { animate, scroll, stagger } from 'motion';
  import { initLiquidField } from '../lib/liquid-field';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const ease = [0.23, 1, 0.32, 1] as const;

  // Ámbar líquido: las gotas se reparten a la derecha para dejar el titular sobre papel.
  const lienzo = document.querySelector<HTMLCanvasElement>('[data-liquido]');
  if (lienzo) {
    const ancho = innerWidth >= 1024;
    initLiquidField(lienzo, ancho ? { bias: [0.76, 0.5], mascara: 0.44 } : { bias: [0.62, 0.2] });
  }
  initLiquidGlass();
  initLuzGlass();

  // Película: pausa accesible, se detiene fuera de pantalla.
  const video = document.querySelector<HTMLVideoElement>('[data-pelicula]')!;
  const toggle = document.querySelector<HTMLButtonElement>('[data-pelicula-toggle]')!;
  const iconos = { pausa: toggle.querySelector('[data-icono="pausa"]')!, play: toggle.querySelector('[data-icono="play"]')! };
  let pausadaPorUsuario = false;
  const pintar = () => {
    iconos.pausa.toggleAttribute('hidden', video.paused);
    iconos.play.toggleAttribute('hidden', !video.paused);
    toggle.setAttribute('aria-label', video.paused ? 'Reproducir la película' : 'Pausar la película');
  };
  const listo = () => video.setAttribute('data-listo', '');
  if (!video.paused && video.readyState >= 3) listo();
  else video.addEventListener('playing', listo, { once: true });
  video.addEventListener('play', pintar);
  video.addEventListener('pause', pintar);
  toggle.addEventListener('click', () => {
    pausadaPorUsuario = !video.paused;
    video.paused ? video.play() : video.pause();
  });
  if (reduce) video.pause();
  new IntersectionObserver(([e]) => {
    if (!e || reduce || pausadaPorUsuario) return;
    e.isIntersecting ? video.play().catch(() => {}) : video.pause();
  }).observe(video);
  pintar();

  if (!reduce) {
    // Keynote: cada palabra se enfoca y asciende; el resto llega después.
    animate('.hero .palabra', { opacity: [0, 1], filter: ['blur(10px)', 'blur(0px)'], y: ['0.28em', '0em'] }, { duration: 0.9, delay: stagger(0.055, { startDelay: 0.08 }), ease });
    animate('.hero .aparece', { opacity: [0, 1], filter: ['blur(8px)', 'blur(0px)'], y: [10, 0] }, { duration: 0.8, delay: stagger(0.08, { startDelay: 0.55 }), ease });
    animate('[data-dispositivo]', { opacity: [0, 1], scale: [0.94, 1], y: [24, 0] }, { duration: 1.1, delay: 0.3, ease });
    // Al hacer scroll, el dispositivo se acerca y el titular se aleja (estilo página de producto).
    const hero = document.querySelector<HTMLElement>('.hero')!;
    scroll(animate('[data-dispositivo]', { scale: [1, 1.06], y: [0, -30] }, { ease: 'linear' }), { target: hero, offset: ['start start', 'end start'] });
    scroll(animate('.hero .titular', { opacity: [1, 0.25], y: [0, -40] }, { ease: 'linear' }), { target: hero, offset: ['start start', 'end start'] });
  }
</script>
