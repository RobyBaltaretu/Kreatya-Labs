---
import type { ContentSnapshot, Project } from '@kreatya/shared';
import { COMPANY_SIZE_LABELS } from '@kreatya/shared';
import { clientLabel, formatMetric } from '../lib/snapshot';
import { projectKinds, sectorName } from '../lib/projects';

interface Props {
  project: Project;
  snapshot: ContentSnapshot;
  index: number;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}
const { project: p, snapshot: s, index, headingLevel = 'h3', eager = false } = Astro.props;
const Heading = headingLevel;
const sector = sectorName(s, p.sectors[0]);
const metric = p.metrics[0];
const kinds = projectKinds(p, s);
const hasDemo = p.demoType !== 'none';
---
<article
  class="group relative flex flex-col border border-line bg-raised transition-shadow hover:shadow-[6px_6px_0_var(--line)]"
  data-project
  data-sector={p.sectors.join(' ')}
  data-tipo={kinds.join(' ')}
  data-tec={p.technologies.join(' ')}
  data-size={p.companySize}
  data-text={`${p.title} ${p.summary} ${clientLabel(p, sector)} ${sector}`.toLowerCase()}
  style={`view-transition-name: ficha-${p.slug}`}
>
  <div class="relative aspect-[16/10] overflow-hidden border-b border-line bg-bg">
    <img src={p.cover} alt="" width="800" height="500" loading={eager ? 'eager' : 'lazy'} decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]" />
    <span class="cota absolute left-3 top-3 bg-bg/90 px-2 py-1">Ficha nº {String(index + 1).padStart(2, '0')}</span>
    {hasDemo && <span class="absolute right-3 top-3 rounded-sm bg-signal px-2 py-1 text-xs font-semibold text-ink">Demo disponible</span>}
  </div>
  <div class="flex flex-1 flex-col gap-3 p-5">
    <p class="text-sm text-muted">{clientLabel(p, sector)}</p>
    <Heading class="font-display text-xl font-semibold leading-snug">
      <a href={`/proyectos/${p.slug}`} class="after:absolute after:inset-0 focus-visible:outline-none">{p.title}</a>
    </Heading>
    {metric && (
      <p class="font-display text-3xl font-semibold tracking-tight text-positive-strong">
        {formatMetric(metric)} <span class="block font-sans text-sm font-normal tracking-normal text-muted">{metric.description}</span>
      </p>
    )}
  </div>
  <dl class="grid grid-cols-3 border-t border-line text-xs">
    <div class="border-r border-line p-3"><dt class="cota">Sector</dt><dd class="mt-1 font-medium">{sector}</dd></div>
    <div class="border-r border-line p-3"><dt class="cota">Plazo</dt><dd class="mt-1 font-medium tabular-nums">{p.durationWeeks} semanas</dd></div>
    <div class="p-3"><dt class="cota">Empresa</dt><dd class="mt-1 font-medium">{COMPANY_SIZE_LABELS[p.companySize].split(' ')[0]} emp.</dd></div>
  </dl>
</article>
