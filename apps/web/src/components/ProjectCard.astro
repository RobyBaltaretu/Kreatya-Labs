---
/** Tarjeta-ficha: una ficha de obra con su cajetín (sector, plazo, empresa). */
import type { ContentSnapshot, Project } from '@kreatya/shared';
import { COMPANY_SIZE_LABELS } from '@kreatya/shared';
import { Icon } from '@kreatya/ui';
import { projectKinds, sectorName } from '../lib/projects';
import { clientLabel, formatMetric } from '../lib/snapshot';

interface Props {
  project: Project;
  snapshot: ContentSnapshot;
  index: number;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
  lead?: boolean;
}
const { project: p, snapshot: s, index, headingLevel = 'h3', eager = false, lead = false } = Astro.props;
const Heading = headingLevel;
const sector = sectorName(s, p.sectors[0]);
const metric = p.metrics[0];
const kinds = projectKinds(p, s);
const hasDemo = p.demoType !== 'none';
---
<article
  class:list={['ficha group relative grid overflow-hidden rounded-xl border border-line bg-raised', lead && 'md:grid-cols-[1.35fr_1fr]']}
  data-project
  data-sector={p.sectors.join(' ')}
  data-tipo={kinds.join(' ')}
  data-tec={p.technologies.join(' ')}
  data-size={p.companySize}
  data-text={`${p.title} ${p.summary} ${clientLabel(p, sector)} ${sector}`.toLowerCase()}
  style={`view-transition-name: ficha-${p.slug}`}
>
  <div class:list={['relative overflow-hidden bg-bg', lead ? 'aspect-[16/10] md:aspect-auto md:min-h-full' : 'aspect-[16/10]']}>
    <img src={p.cover} alt="" width="800" height="500" loading={eager ? 'eager' : 'lazy'} decoding="async" class="ficha-img h-full w-full object-cover" />
    {hasDemo && <span class="absolute left-3 top-3 rounded-md bg-ink px-2 py-1 text-xs font-semibold text-paper">Demo disponible</span>}
  </div>
  <div class="flex flex-col">
    <div class="flex flex-1 flex-col gap-3 p-5 sm:p-6">
      <p class="text-sm text-muted">{clientLabel(p, sector)}</p>
      <Heading class:list={['leading-snug', lead ? 'text-heading' : 'text-xl']}>
        <a href={`/proyectos/${p.slug}`} class="after:absolute after:inset-0 after:rounded-xl focus-visible:outline-none">{p.title}</a>
      </Heading>
      {lead && <p class="text-muted">{p.summary}</p>}
      {metric && (
        <p class="mt-auto pt-2">
          <span class:list={['block font-display font-semibold tracking-tight text-positive-strong tabular-nums', lead ? 'text-5xl' : 'text-3xl']}>{formatMetric(metric)}</span>
          <span class="text-sm text-muted">{metric.description}</span>
        </p>
      )}
    </div>
    <dl class="grid grid-cols-[1fr_auto_auto] border-t border-line text-sm">
      <div class="px-5 py-3 sm:px-6"><dt class="sr-only">Sector</dt><dd>{sector}</dd></div>
      <div class="border-l border-line px-4 py-3"><dt class="sr-only">Plazo</dt><dd class="medida">{p.durationWeeks} sem.</dd></div>
      <div class="border-l border-line px-4 py-3"><dt class="sr-only">Empresa</dt><dd class="medida">{COMPANY_SIZE_LABELS[p.companySize].split(' ')[0]}</dd></div>
    </dl>
  </div>
  <span class="ficha-go pointer-events-none absolute right-4 top-4 grid h-9 w-9 place-items-center rounded-full bg-bg/90 text-fg" aria-hidden="true"><Icon name="arrow-right" size={18} /></span>
  <span class="sr-only">Ficha nº {index + 1}</span>
</article>
<style>
  .ficha {
    transition: border-color 200ms ease;
  }
  .ficha-img {
    transition: transform 500ms var(--ease-out);
  }
  .ficha-go {
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 160ms ease,
      transform 200ms var(--ease-out);
  }
  @media (hover: hover) and (pointer: fine) {
    .ficha:hover {
      border-color: color-mix(in oklab, var(--fg) 35%, transparent);
    }
    .ficha:hover .ficha-img {
      transform: scale(1.02);
    }
    .ficha:hover .ficha-go {
      opacity: 1;
      transform: none;
    }
  }
  .ficha:focus-within {
    border-color: var(--focus);
  }
  .ficha:active {
    transform: scale(0.995);
    transition: transform 120ms var(--ease-out);
  }
</style>
