---
/**
 * «Blueprint vivo»: el proceso manual de un negocio ficticio se traza como plano y
 * la interfaz terminada se revela encima con una máscara. Un solo momento de autor
 * (~1,9 s, una vez). Estado final visible sin JS y directo con reduced motion.
 * Siempre sobre lámina azul tinta: los colores son los de la cianotipia.
 */
---
<figure class="bp relative w-full" aria-labelledby="bp-caption">
  <svg viewBox="0 0 520 430" class="h-auto w-full overflow-visible" role="img" aria-labelledby="bp-title">
    <title id="bp-title">Plano de un proceso manual (pedido por email, tres Excel y factura) convertido en un panel de pedidos con métricas y un copiloto de IA</title>

    <!-- 1 · El plano del proceso actual -->
    <g class="bp-plan" fill="none" stroke="#8FB4E0" stroke-width="1.4">
      <g class="bp-trazo">
        <rect x="8" y="44" width="132" height="50" rx="4"></rect>
        <rect x="194" y="44" width="132" height="50" rx="4" stroke-dasharray="5 4"></rect>
        <rect x="380" y="44" width="132" height="50" rx="4"></rect>
        <path d="M140 69h54M326 69h54"></path>
      </g>
      <path d="M186 64l8 5-8 5M372 64l8 5-8 5" fill="#8FB4E0" stroke="none" class="bp-texto"></path>
      <g class="bp-texto" fill="#C9D3E4" stroke="none" font-family="var(--font-mono)" font-size="13">
        <text x="74" y="74" text-anchor="middle">Pedido · email</text>
        <text x="260" y="74" text-anchor="middle">Excel × 3</text>
        <text x="446" y="74" text-anchor="middle">Factura</text>
      </g>
      <g class="bp-texto" font-family="var(--font-mono)" font-size="12.5" fill="#8FB4E0">
        <path d="M8 16h504M8 10v12M512 10v12" stroke="#8FB4E0" stroke-width="1"></path>
        <rect x="170" y="7" width="180" height="18" fill="#14213D" stroke="none"></rect>
        <text x="260" y="20.5" text-anchor="middle" fill="#C9D3E4">14 h/semana a mano</text>
      </g>
    </g>

    <!-- 2 · La interfaz terminada, revelada con máscara -->
    <g class="bp-ui">
      <rect x="8" y="122" width="504" height="300" rx="10" fill="#F7F5F0"></rect>
      <path d="M18 122h484a10 10 0 0 1 10 10v22H8v-22a10 10 0 0 1 10-10Z" fill="#1B2B4D"></path>
      <circle cx="28" cy="138" r="4.5" fill="#FF6B2C"></circle>
      <circle cx="44" cy="138" r="4.5" fill="#F7F5F0" opacity=".35"></circle>
      <circle cx="60" cy="138" r="4.5" fill="#F7F5F0" opacity=".35"></circle>
      <text x="260" y="142.5" text-anchor="middle" font-family="var(--font-mono)" font-size="12" fill="#C9D3E4">tunegocio.es/pedidos</text>

      <g font-family="var(--font-sans)">
        <rect x="24" y="170" width="146" height="72" rx="8" fill="#FFFFFF" stroke="#D9D4C7"></rect>
        <text x="38" y="194" font-size="12" fill="#4A5468">Facturación</text>
        <text x="38" y="226" font-size="26" font-weight="650" font-family="var(--font-display)" fill="#1F7A50">−70 %</text>
        <rect x="186" y="170" width="146" height="72" rx="8" fill="#FFFFFF" stroke="#D9D4C7"></rect>
        <text x="200" y="194" font-size="12" fill="#4A5468">Ahorro semanal</text>
        <text x="200" y="226" font-size="26" font-weight="650" font-family="var(--font-display)" fill="#14213D">12 h</text>
        <rect x="348" y="170" width="148" height="72" rx="8" fill="#FFFFFF" stroke="#D9D4C7"></rect>
        <text x="362" y="194" font-size="12" fill="#4A5468">Errores</text>
        <text x="362" y="226" font-size="26" font-weight="650" font-family="var(--font-display)" fill="#14213D">0</text>
      </g>
      <g font-family="var(--font-sans)" font-size="13" fill="#14213D">
        <text x="28" y="282">#2041 · Ferretería Sol</text>
        <rect x="406" y="268" width="90" height="22" rx="11" fill="#2E9E6A" opacity=".16"></rect>
        <text x="451" y="283" text-anchor="middle" font-size="12" fill="#1F7A50">Facturado</text>
        <path d="M24 300h472" stroke="#E6E1D5"></path>
        <text x="28" y="324">#2042 · Hnos. Vidal</text>
        <rect x="406" y="310" width="90" height="22" rx="11" fill="#2E9E6A" opacity=".16"></rect>
        <text x="451" y="325" text-anchor="middle" font-size="12" fill="#1F7A50">Facturado</text>
        <path d="M24 342h472" stroke="#E6E1D5"></path>
        <text x="28" y="366">#2043 · Talleres Norte</text>
        <rect x="406" y="352" width="90" height="22" rx="11" fill="#FF6B2C" opacity=".18"></rect>
        <text x="451" y="367" text-anchor="middle" font-size="12" fill="#14213D">En ruta</text>
      </g>
    </g>

    <!-- 3 · Copiloto: un compañero, no un robot -->
    <g class="bp-copiloto" font-family="var(--font-sans)">
      <rect x="236" y="384" width="268" height="54" rx="10" fill="#14213D" stroke="#2F4168"></rect>
      <circle cx="260" cy="411" r="9" fill="#FF6B2C"></circle>
      <text x="278" y="406" font-size="13" font-weight="600" fill="#F7F5F0">Copiloto</text>
      <text x="278" y="424" font-size="12.5" fill="#C9D3E4">12 albaranes leídos y conciliados</text>
    </g>
  </svg>
  <figcaption id="bp-caption" class="sr-only">De la operativa con hojas de cálculo a un sistema a medida con IA.</figcaption>
</figure>

<style>
  .bp-trazo {
    stroke-dasharray: 700;
    animation: bp-trazar 900ms var(--ease-out) both;
  }
  .bp-texto {
    animation: bp-aparecer 400ms 350ms ease both;
  }
  .bp-ui {
    animation: bp-revelar 650ms 820ms var(--ease-in-out) both;
  }
  .bp-copiloto {
    transform-origin: 370px 411px;
    animation: bp-llegar 320ms 1550ms var(--ease-out) both;
  }
  @keyframes bp-trazar {
    from { stroke-dashoffset: 700; }
    to { stroke-dashoffset: 0; }
  }
  @keyframes bp-aparecer {
    from { opacity: 0; }
  }
  @keyframes bp-revelar {
    from { clip-path: inset(0 0 100% 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  @keyframes bp-llegar {
    from { opacity: 0; transform: translateY(6px) scale(0.96); }
  }
  @media (prefers-reduced-motion: reduce) {
    .bp-trazo, .bp-texto, .bp-ui, .bp-copiloto { animation: none; }
  }
</style>
