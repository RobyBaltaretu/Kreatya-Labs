---
/**
 * «Blueprint vivo»: el proceso manual de un negocio ficticio (trazado como plano)
 * se transforma en la interfaz de la solución terminada. Estado final visible sin JS
 * y directo con prefers-reduced-motion.
 */
---
<figure class="bp relative w-full" aria-labelledby="bp-caption">
  <svg viewBox="0 0 560 440" class="h-auto w-full" role="img" aria-labelledby="bp-title">
    <title id="bp-title">Plano de un proceso manual (pedido por email, Excel, almacén y factura) convertido en un panel de gestión con métricas y un copiloto de IA</title>

    <!-- Capa 1: el plano del proceso actual -->
    <g class="bp-plan" fill="none" stroke="var(--diagram)" stroke-width="1.2">
      <g class="bp-draw">
        <rect x="24" y="40" width="110" height="46" rx="3"></rect>
        <rect x="224" y="40" width="110" height="46" rx="3" stroke-dasharray="4 3"></rect>
        <rect x="424" y="40" width="110" height="46" rx="3"></rect>
        <rect x="224" y="150" width="110" height="46" rx="3" stroke-dasharray="4 3"></rect>
        <path d="M134 63h90M334 63h90M279 86v64M334 173c60 0 145-20 145-87"></path>
        <path d="M218 59l6 4-6 4M418 59l6 4-6 4M275 144l4 6 4-6" fill="var(--diagram)" stroke="none"></path>
      </g>
      <g class="bp-text" fill="var(--diagram)" stroke="none" font-family="var(--font-mono)" font-size="10" letter-spacing=".08em">
        <text x="79" y="67" text-anchor="middle">PEDIDO · EMAIL</text>
        <text x="279" y="67" text-anchor="middle">EXCEL × 3</text>
        <text x="479" y="67" text-anchor="middle">FACTURA</text>
        <text x="279" y="177" text-anchor="middle">ALMACÉN</text>
        <text x="179" y="54" text-anchor="middle" font-size="8.5">COPIAR</text>
        <text x="379" y="54" text-anchor="middle" font-size="8.5">TECLEAR</text>
      </g>
      <!-- Cota: tiempo perdido -->
      <g class="bp-text" font-family="var(--font-mono)" font-size="9" fill="var(--diagram)">
        <path d="M24 20h510M24 15v10M534 15v10" stroke="var(--diagram)" stroke-width="1" fill="none"></path>
        <rect x="216" y="13" width="126" height="14" fill="var(--bg)" stroke="none"></rect>
        <text x="279" y="23.5" text-anchor="middle" letter-spacing=".08em">14 H/SEMANA MANUALES</text>
      </g>
    </g>

    <!-- Capa 2: la interfaz terminada -->
    <g class="bp-ui">
      <rect class="bp-panel" x="24" y="110" width="510" height="306" rx="8" fill="var(--bg-raised)" stroke="var(--line)" stroke-width="1.5"></rect>
      <g class="bp-panel">
        <rect x="24" y="110" width="510" height="30" rx="8" fill="var(--ink)"></rect>
        <rect x="24" y="126" width="510" height="14" fill="var(--ink)"></rect>
        <circle cx="42" cy="125" r="4" fill="var(--signal)"></circle>
        <circle cx="56" cy="125" r="4" fill="#f7f5f0" opacity=".5"></circle>
        <circle cx="70" cy="125" r="4" fill="#f7f5f0" opacity=".5"></circle>
        <text x="279" y="129" text-anchor="middle" font-family="var(--font-mono)" font-size="9.5" fill="#f7f5f0" letter-spacing=".06em">app.tunegocio.es / pedidos</text>
      </g>
      <g class="bp-panel" font-family="var(--font-sans)">
        <rect x="24" y="140" width="96" height="276" fill="var(--bg)" stroke="var(--line)"></rect>
        <rect x="36" y="158" width="72" height="22" rx="4" fill="var(--signal)"></rect>
        <text x="46" y="173" font-size="10" font-weight="600" fill="var(--ink)">Pedidos</text>
        <text x="46" y="203" font-size="10" fill="var(--fg-muted)">Almacén</text>
        <text x="46" y="228" font-size="10" fill="var(--fg-muted)">Facturas</text>
        <text x="46" y="253" font-size="10" fill="var(--fg-muted)">Clientes</text>
        <text x="46" y="278" font-size="10" fill="var(--fg-muted)">Informes</text>
      </g>
      <g class="bp-kpi" font-family="var(--font-display)">
        <rect x="136" y="156" width="120" height="66" rx="5" fill="var(--bg)" stroke="var(--line)"></rect>
        <text x="148" y="178" font-size="9" font-family="var(--font-mono)" fill="var(--diagram)" letter-spacing=".08em">FACTURACIÓN</text>
        <text x="148" y="206" font-size="22" font-weight="600" fill="var(--positive-strong)">−70 %</text>
        <rect x="266" y="156" width="120" height="66" rx="5" fill="var(--bg)" stroke="var(--line)"></rect>
        <text x="278" y="178" font-size="9" font-family="var(--font-mono)" fill="var(--diagram)" letter-spacing=".08em">AHORRO</text>
        <text x="278" y="206" font-size="22" font-weight="600" fill="var(--positive-strong)">12 h/sem</text>
        <rect x="396" y="156" width="124" height="66" rx="5" fill="var(--bg)" stroke="var(--line)"></rect>
        <text x="408" y="178" font-size="9" font-family="var(--font-mono)" fill="var(--diagram)" letter-spacing=".08em">ERRORES</text>
        <text x="408" y="206" font-size="22" font-weight="600" fill="var(--positive-strong)">0</text>
      </g>
      <g class="bp-rows" font-family="var(--font-sans)" font-size="10">
        <rect x="136" y="236" width="384" height="24" fill="var(--bg)"></rect>
        <text x="146" y="252" fill="var(--fg-muted)" font-family="var(--font-mono)" font-size="8.5" letter-spacing=".06em">PEDIDO</text>
        <text x="250" y="252" fill="var(--fg-muted)" font-family="var(--font-mono)" font-size="8.5" letter-spacing=".06em">CLIENTE</text>
        <text x="420" y="252" fill="var(--fg-muted)" font-family="var(--font-mono)" font-size="8.5" letter-spacing=".06em">ESTADO</text>
        <g class="bp-row"><text x="146" y="280" fill="var(--fg)">#2041</text><text x="250" y="280" fill="var(--fg)">Ferretería Sol</text><rect x="420" y="269" width="64" height="16" rx="8" fill="var(--success)" opacity=".18"></rect><text x="430" y="280" fill="var(--positive)" font-size="9">Facturado</text></g>
        <g class="bp-row"><text x="146" y="306" fill="var(--fg)">#2042</text><text x="250" y="306" fill="var(--fg)">Hnos. Vidal</text><rect x="420" y="295" width="64" height="16" rx="8" fill="var(--success)" opacity=".18"></rect><text x="430" y="306" fill="var(--positive)" font-size="9">Facturado</text></g>
        <g class="bp-row"><text x="146" y="332" fill="var(--fg)">#2043</text><text x="250" y="332" fill="var(--fg)">Talleres Norte</text><rect x="420" y="321" width="64" height="16" rx="8" fill="var(--signal)" opacity=".2"></rect><text x="430" y="332" fill="var(--fg)" font-size="9">En ruta</text></g>
        <path d="M136 290h384M136 316h384M136 342h384" stroke="var(--line)"></path>
      </g>
      <!-- Copiloto IA: un compañero, no un robot -->
      <g class="bp-copilot" font-family="var(--font-sans)">
        <path d="M300 372l-6 14 4-3 3 6 3-1-3-6 5-1z" fill="var(--ink)" stroke="#f7f5f0" stroke-width="1"></path>
        <rect x="312" y="360" width="208" height="42" rx="6" fill="var(--ink)"></rect>
        <circle cx="328" cy="381" r="7" fill="var(--signal)"></circle>
        <text x="342" y="377" font-size="9.5" fill="#f7f5f0" font-weight="600">Copiloto</text>
        <text x="342" y="391" font-size="9" fill="#c9d3e4">12 albaranes leídos y conciliados</text>
      </g>
    </g>
  </svg>
  <figcaption id="bp-caption" class="sr-only">De la operativa con hojas de cálculo a un sistema a medida con IA.</figcaption>
</figure>

<style>
  .bp-draw {
    stroke-dasharray: 900;
    stroke-dashoffset: 0;
    animation: bp-draw 1.4s ease-out both;
  }
  .bp-text {
    animation: bp-fade 0.6s 0.6s ease-out both;
  }
  .bp-plan {
    animation: bp-recede 0.8s 1.8s ease-in-out both;
  }
  .bp-panel {
    animation: bp-rise 0.6s 1.6s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .bp-kpi {
    animation: bp-rise 0.5s 2s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }
  .bp-row:nth-child(5) { animation: bp-fade 0.4s 2.3s both; }
  .bp-row:nth-child(6) { animation: bp-fade 0.4s 2.45s both; }
  .bp-row:nth-child(7) { animation: bp-fade 0.4s 2.6s both; }
  .bp-copilot {
    animation: bp-pop 0.5s 2.9s cubic-bezier(0.3, 1.4, 0.5, 1) both;
    transform-origin: 400px 380px;
  }
  @keyframes bp-draw { from { stroke-dashoffset: 900; } }
  @keyframes bp-fade { from { opacity: 0; } }
  @keyframes bp-recede { to { opacity: 0.45; } }
  @keyframes bp-rise { from { opacity: 0; transform: translateY(14px); } }
  @keyframes bp-pop { from { opacity: 0; transform: scale(0.85); } }
  @media (prefers-reduced-motion: reduce) {
    .bp * { animation: none !important; }
    .bp-plan { opacity: 0.45; }
  }
</style>
