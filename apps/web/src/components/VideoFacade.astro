---
import type { Project } from '@kreatya/shared';
interface Props { video: NonNullable<Project['mainVideo']>; title: string; }
const { video, title } = Astro.props;
const pending = video.ref === 'pendiente';
const mins = `${Math.floor(video.durationSeconds / 60)}:${String(video.durationSeconds % 60).padStart(2, '0')}`;
const src = video.provider === 'youtube' ? `https://www.youtube-nocookie.com/embed/${video.ref}?autoplay=1&cc_load_policy=1&hl=es` : video.ref;
---
<div class="video-facade relative aspect-video overflow-hidden border border-line bg-ink" data-src={pending ? '' : src} data-provider={video.provider} data-title={title}>
  <img src={video.poster} alt="" width="1280" height="720" fetchpriority="high" class="h-full w-full object-cover opacity-80" />
  {pending ? (
    <p class="absolute inset-0 grid place-items-center bg-ink/60 p-6 text-center font-display text-xl text-paper">Vídeo en producción · {mins} min</p>
  ) : (
    <button type="button" class="absolute inset-0 grid place-items-center text-paper" aria-label={`Reproducir vídeo: ${title} (${mins} min, con subtítulos)`}>
      <span class="grid h-20 w-20 place-items-center rounded-full bg-signal text-ink shadow-xl transition-transform hover:scale-105">
        <svg viewBox="0 0 24 24" class="ml-1 h-8 w-8" aria-hidden="true"><path d="M7 4v16l13-8z" fill="currentColor"></path></svg>
      </span>
      <span class="cota absolute bottom-4 left-4 bg-ink/80 px-2 py-1" style="color:#f7f5f0">{mins} · subtítulos</span>
    </button>
  )}
</div>
{video.transcript && (
  <details class="mt-3 text-sm">
    <summary class="cursor-pointer font-medium">Transcripción del vídeo</summary>
    <p class="mt-2 max-w-[70ch] text-muted">{video.transcript}</p>
  </details>
)}
<script>
  // Facade: el reproductor (y sus cookies) solo se carga al hacer clic.
  document.querySelectorAll<HTMLElement>('.video-facade').forEach((el) => {
    el.querySelector('button')?.addEventListener('click', () => {
      const src = el.dataset.src;
      if (!src) return;
      const media = el.dataset.provider === 'youtube' ? document.createElement('iframe') : document.createElement('video');
      if (media instanceof HTMLIFrameElement) {
        media.allow = 'autoplay; encrypted-media; picture-in-picture';
        media.allowFullscreen = true;
        media.title = el.dataset.title ?? 'Vídeo';
      } else {
        media.controls = true;
        media.autoplay = true;
      }
      media.src = src;
      media.className = 'absolute inset-0 h-full w-full';
      el.replaceChildren(media);
    });
  });
</script>
