---
import { siteConfig } from '@kreatya/shared/site.config';
import { getSnapshot } from '../lib/snapshot';

const s = await getSnapshot();
const { contact } = siteConfig;
const year = 2026;
const groups = [
  { title: 'Soluciones', links: s.solutions.map((x) => ({ href: `/soluciones/${x.slug}`, label: x.name })) },
  { title: 'Sectores', links: s.sectors.map((x) => ({ href: `/sectores/${x.slug}`, label: x.name })) },
  {
    title: 'Empresa',
    links: [
      { href: '/empresa', label: 'Quiénes somos' },
      { href: '/metodo', label: 'Método' },
      { href: '/precios', label: 'Precios' },
      { href: '/blog', label: 'Blog y guías' },
      { href: siteConfig.social.linkedin, label: 'LinkedIn' },
      { href: siteConfig.social.youtube, label: 'YouTube' },
    ],
  },
];
---
<footer class="border-t border-line">
  <div class="wrap grid gap-12 py-16 md:grid-cols-[1.5fr_repeat(3,1fr)]">
    <div class="grid content-start gap-4">
      <p class="font-display text-xl font-semibold tracking-tight">{siteConfig.name}</p>
      <p class="max-w-[30ch] text-muted">{siteConfig.claim}</p>
      <address class="not-italic text-sm leading-7 text-muted">
        {siteConfig.legalName}<br />
        {contact.address.street}, {contact.address.postalCode} {contact.address.city}<br />
        <a class="hover:text-fg" href={`tel:${contact.phone.replaceAll(' ', '')}`}>{contact.phone}</a> · <a class="hover:text-fg" href={`mailto:${contact.email}`}>{contact.email}</a>
      </address>
    </div>
    {groups.map((g) => (
      <nav aria-label={g.title}>
        <h2 class="mb-4 font-sans text-sm font-semibold tracking-normal">{g.title}</h2>
        <ul class="grid gap-2.5 text-sm text-muted">{g.links.map((l) => <li><a class="transition-colors hover:text-fg" href={l.href}>{l.label}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <div class="border-t border-line">
    <div class="wrap flex flex-wrap items-center justify-between gap-4 py-6 text-sm text-muted">
      <p>© {year} {siteConfig.legalName}. El código y los datos de nuestros clientes son suyos.</p>
      <ul class="flex flex-wrap gap-x-5 gap-y-2">
        <li><a class="hover:text-fg" href="/legal/aviso-legal">Aviso legal</a></li>
        <li><a class="hover:text-fg" href="/legal/privacidad">Privacidad</a></li>
        <li><a class="hover:text-fg" href="/legal/cookies">Cookies</a></li>
        <li><button type="button" class="hover:text-fg" data-open-cookies>Configurar cookies</button></li>
      </ul>
    </div>
  </div>
</footer>
