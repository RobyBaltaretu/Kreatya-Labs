---
import type { ContentSnapshot, Post } from '@kreatya/shared';
import { Icon } from '@kreatya/ui';
import Blocks from './Blocks.astro';
import CtaBand from './CtaBand.astro';
import ProjectCard from './ProjectCard.astro';
import { formatDate } from '../lib/snapshot';
interface Props { post: Post; snapshot: ContentSnapshot; }
const { post, snapshot: s } = Astro.props;
const author = s.authors.find((a) => a.slug === post.authorSlug);
const project = s.projects.find((p) => p.slug === post.projectSlug);
const solution = s.solutions.find((x) => x.slug === post.solutionSlug);
---
<article class="wrap grid gap-14 pb-20 pt-10 lg:grid-cols-[1.8fr_1fr] lg:gap-20">
  <div class="min-w-0">
    <h1 class="text-title max-w-[20ch]">{post.title}</h1>
    <p class="mt-5 text-sm text-muted">
      {post.kind === 'guia' ? 'Guía' : 'Artículo'} de <strong class="font-semibold text-fg">{author?.name}</strong> · <time datetime={post.publishedAt}>{formatDate(post.publishedAt)}</time>
      {post.updatedAt !== post.publishedAt && <> · actualizado el <time datetime={post.updatedAt}>{formatDate(post.updatedAt)}</time></>}
    </p>
    <div class="mt-10"><Blocks blocks={post.blocks} /></div>
    {author && (
      <aside class="mt-16 max-w-[66ch] border-t border-line pt-6" aria-label="Sobre el autor">
        <p class="font-semibold">{author.name} <span class="font-normal text-muted">· {author.role}</span></p>
        <p class="mt-2 text-muted">{author.bio}</p>
        <p class="mt-2 text-sm text-muted">{author.credentials.join(' · ')}</p>
      </aside>
    )}
  </div>
  <aside class="grid content-start gap-6 lg:sticky lg:top-24">
    {solution && (
      <a href={`/soluciones/${solution.slug}`} class="group flex items-center justify-between gap-4 rounded-3xl border border-line p-5 transition-colors hover:border-fg/40">
        <span><span class="block text-sm text-muted">Solución relacionada</span><span class="font-display text-lg font-semibold">{solution.name}</span></span>
        <Icon name="arrow-right" />
      </a>
    )}
    {project && <ProjectCard project={project} snapshot={s} index={s.projects.indexOf(project)} />}
  </aside>
</article>
<CtaBand />
