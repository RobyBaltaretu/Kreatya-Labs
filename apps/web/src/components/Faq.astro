---
import type { Faq } from '@kreatya/shared';
import { Icon } from '@kreatya/ui';
interface Props { faqs: Faq[]; title?: string; }
const { faqs, title = 'Preguntas frecuentes' } = Astro.props;
---
<section class="wrap seccion" aria-labelledby="faq-title">
  <div class="grid gap-10 lg:grid-cols-[1fr_1.8fr] lg:gap-16">
    <h2 id="faq-title" class="text-title max-w-[12ch]">{title}</h2>
    <div class="border-t border-line">
      {faqs.map((f) => (
        <details class="acordeon border-b border-line">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-5 font-display text-lg font-semibold [&::-webkit-details-marker]:hidden">
            {f.question}
            <span class="mt-0.5 text-diagram"><Icon name="plus" size={20} /></span>
          </summary>
          <p class="max-w-[64ch] pb-6 text-muted">{f.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
