---
import type { Testimonial } from '@kreatya/shared';
interface Props { t: Testimonial; large?: boolean; }
const { t, large = false } = Astro.props;
---
<figure class="flex h-full flex-col justify-between gap-6 border border-line bg-raised p-6 sm:p-8">
  <blockquote class:list={['font-display font-medium leading-snug', large ? 'text-2xl sm:text-3xl' : 'text-xl']}>
    <span aria-hidden="true" class="text-signal">“</span>{t.quote}<span aria-hidden="true" class="text-signal">”</span>
  </blockquote>
  <figcaption class="flex items-center gap-3 text-sm">
    <span aria-hidden="true" class="grid h-10 w-10 place-items-center rounded-full border border-line font-mono text-xs">{t.name.split(' ').map((w) => w[0]).slice(0, 2).join('')}</span>
    <span><strong class="block">{t.name}</strong><span class="text-muted">{t.role} · {t.company}</span></span>
  </figcaption>
</figure>
