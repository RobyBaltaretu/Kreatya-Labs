---
import type { Testimonial } from '@kreatya/shared';
interface Props { t: Testimonial; large?: boolean; }
const { t, large = false } = Astro.props;
---
<figure class="grid content-start gap-6">
  <blockquote class:list={['font-display font-medium tracking-tight', large ? 'text-title leading-[1.12]' : 'text-xl leading-snug']}>
    «{t.quote}»
  </blockquote>
  <figcaption class="text-sm">
    <strong class="block font-semibold">{t.name}</strong>
    <span class="text-muted">{t.role} · {t.company}</span>
  </figcaption>
</figure>
