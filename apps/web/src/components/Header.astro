---
import { siteConfig } from '@kreatya/shared/site.config';
import { Icon } from '@kreatya/ui';

const nav = [
  { href: '/soluciones', label: 'Soluciones' },
  { href: '/sectores', label: 'Sectores' },
  { href: '/proyectos', label: 'Proyectos' },
  { href: '/ia-para-empresas', label: 'IA aplicada' },
  { href: '/precios', label: 'Precios' },
  { href: '/metodo', label: 'Método' },
];
const path = Astro.url.pathname;
const active = (href: string) => path === href || path.startsWith(`${href}/`);
---
<a href="#contenido" class="sr-only-focusable fixed left-4 top-4 z-50 rounded-lg bg-signal px-4 py-2 font-semibold text-ink">Saltar al contenido</a>
<header class="site-header sticky z-40 px-3 pt-3 sm:px-4" style="top: env(safe-area-inset-top, 0px)">
  <div class="barra glass glass-luz mx-auto flex h-14 max-w-[1040px] items-center justify-between gap-4 rounded-full pl-3 pr-2" data-glass data-glass-grosor="40" data-glass-bisel="18">
    <a href="/" class="flex items-center gap-2 rounded-full px-1 font-display text-[1.0625rem] font-semibold tracking-tight" aria-label={`${siteConfig.name}, inicio`}>
      <svg viewBox="0 0 32 32" class="h-8 w-8" aria-hidden="true">
        <defs>
          <linearGradient id="logo-ambar" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#ffd25a"></stop>
            <stop offset="1" stop-color="#f08a0c"></stop>
          </linearGradient>
        </defs>
        <rect x="1" y="1" width="30" height="30" rx="9" fill="#1d1d1f"></rect>
        <path d="M1 19c6-3.2 11.5 2.6 17.5-.4S27 15 31 16.6V22a9 9 0 0 1-9 9H10a9 9 0 0 1-9-9z" fill="url(#logo-ambar)"></path>
        <path d="M11 8.5v15M11 16.5 19.5 8.5M14.2 13.6 21 23.5" fill="none" stroke="#f5f5f7" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"></path>
      </svg>
      <span>Kreatya Labs</span>
    </a>
    <nav aria-label="Principal" class="hidden lg:block">
      <ul class="flex items-center gap-0.5 text-[0.9375rem]">
        {nav.map((n) => (
          <li>
            <a href={n.href} class:list={['nav-link relative rounded-full px-3 py-1.5 text-muted transition-colors hover:text-fg', active(n.href) && 'is-active text-fg']} aria-current={active(n.href) ? 'page' : undefined}>{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="flex items-center gap-1.5">
      <a href={siteConfig.primaryCta.href} class="btn btn-primary hidden min-h-10 py-2 text-[0.9375rem] sm:inline-flex" data-cta="header">{siteConfig.primaryCta.label}</a>
      <button type="button" class="btn min-h-10 w-10 px-0 lg:hidden" id="menu-open" aria-controls="menu-movil" aria-expanded="false">
        <span class="sr-only">Abrir menú</span>
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
</header>
<div id="menu-movil" class="menu-movil sobre-tinta fixed inset-0 z-50 flex flex-col lg:hidden" role="dialog" aria-modal="true" aria-label="Menú" data-open="false" inert>
  <div class="wrap flex h-16 items-center justify-end" style="margin-top: env(safe-area-inset-top, 0px)">
    <button type="button" class="btn btn-glass min-h-11 w-11 px-0" id="menu-close"><span class="sr-only">Cerrar menú</span><Icon name="x" size={20} /></button>
  </div>
  <nav class="wrap flex-1 overflow-y-auto pb-10" aria-label="Principal móvil">
    <ul class="grid pt-4">
      {[{ href: '/', label: 'Inicio' }, ...nav, { href: '/empresa', label: 'Empresa' }, { href: '/blog', label: 'Blog y guías' }].map((n, i) => (
        <li class="menu-item" style={`--i:${i}`}><a href={n.href} class="block border-b border-white/10 py-3.5 font-display text-[2rem] font-semibold tracking-tight">{n.label}</a></li>
      ))}
    </ul>
    <a href={siteConfig.primaryCta.href} class="btn btn-primary mt-8 w-full text-lg">{siteConfig.primaryCta.label}</a>
  </nav>
</div>
<style>
  /* Barra flotante: el vidrio gana opacidad al haber contenido debajo. */
  .barra {
    transition:
      background-color 240ms ease,
      box-shadow 240ms ease;
  }
  .site-header[data-scroll='true'] .barra {
    background: var(--glass-tint-strong);
  }
  .nav-link.is-active {
    background: color-mix(in oklab, var(--fg) 8%, transparent);
  }
  /* Menú móvil: una lámina de vidrio oscuro que se aclara desde arriba. */
  .menu-movil {
    background: rgb(22 22 24 / 0.72);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
    backdrop-filter: blur(28px) saturate(180%);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 200ms var(--ease-out),
      visibility 0s linear 200ms;
  }
  .menu-movil[data-open='true'] {
    opacity: 1;
    visibility: visible;
    transition:
      opacity 280ms var(--ease-out),
      visibility 0s;
  }
  @media (prefers-reduced-transparency: reduce) {
    .menu-movil {
      background: var(--tinta);
    }
  }
  .menu-item {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 160ms ease,
      transform 160ms var(--ease-out);
  }
  .menu-movil[data-open='true'] .menu-item {
    opacity: 1;
    transform: none;
    transition-duration: 280ms;
    transition-delay: calc(80ms + var(--i) * 30ms);
  }
</style>
<script>
  import { initLiquidGlass, initLuzGlass } from '@kreatya/ui/liquid-glass';
  const header = document.querySelector<HTMLElement>('.site-header')!;
  const marcar = () => (header.dataset.scroll = String(window.scrollY > 8));
  marcar();
  window.addEventListener('scroll', marcar, { passive: true });
  initLiquidGlass(header);
  initLuzGlass();
  const panel = document.getElementById('menu-movil')!;
  const openBtn = document.getElementById('menu-open')!;
  const closeBtn = document.getElementById('menu-close')!;
  const set = (open: boolean) => {
    panel.dataset.open = String(open);
    panel.inert = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.documentElement.style.overflow = open ? 'hidden' : '';
    (open ? closeBtn : openBtn).focus();
  };
  openBtn.addEventListener('click', () => set(true));
  closeBtn.addEventListener('click', () => set(false));
  panel.addEventListener('keydown', (e) => e.key === 'Escape' && set(false));
</script>
