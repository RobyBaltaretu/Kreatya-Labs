---
/** Antes / después del proceso, dibujado como dos trazados de un plano. */
import type { ProcessStep } from '@kreatya/shared';
import { Icon } from '@kreatya/ui';

interface Props { before: ProcessStep[]; after: ProcessStep[]; }
const { before, after } = Astro.props;
const rows = [
  { label: 'Antes', steps: before, after: false },
  { label: 'Después', steps: after, after: true },
];
---
<div class="grid gap-8 rounded-3xl border border-line bg-raised p-5 sm:p-8">
  {rows.map((r) => (
    <div class="grid gap-3">
      <div class="flex items-baseline justify-between gap-4">
        <h3 class="font-sans text-base font-semibold tracking-normal">{r.label}</h3>
        <p class="medida text-muted">{r.steps.length} pasos</p>
      </div>
      <ol class="flex flex-wrap items-center gap-2" aria-label={`Proceso ${r.label.toLowerCase()}`}>
        {r.steps.map((s, i) => (
          <li class="flex items-center gap-2">
            <span class:list={[
              'rounded-md px-3 py-2 text-sm',
              r.after ? 'bg-ink font-semibold text-paper' : 'border border-dashed border-diagram/50 text-muted',
            ]}>{s.label}</span>
            {i < r.steps.length - 1 && <span class="text-diagram"><Icon name="arrow-right" size={16} /></span>}
          </li>
        ))}
      </ol>
    </div>
  ))}
</div>
