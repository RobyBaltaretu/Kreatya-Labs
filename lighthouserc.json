{
  "ci": {
    "collect": {
      "staticDistDir": "./apps/web/dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/proyectos/index.html",
        "http://localhost/proyectos/albaran-digital-transportes-levante/index.html",
        "http://localhost/diagnostico/index.html",
        "http://localhost/precios/index.html"
      ],
      "numberOfRuns": 1,
      "settings": { "preset": "desktop" }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.95 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }]
      }
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
